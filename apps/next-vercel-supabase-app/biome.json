{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "root": false,
  "extends": ["../../biome.json"],
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "rules": {
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  }
}
