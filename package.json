{
  "name": "personal-tools",
  "private": true,
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "dev": "pnpm --filter playground dev",
    "build": "pnpm --filter playground build",
    "test": "pnpm --filter playground test",
    "test:e2e": "pnpm --filter playground test:e2e",
    "typecheck": "pnpm --filter playground typecheck",
    "dev:next": "pnpm --filter next-vercel-supabase-app dev",
    "check:next": "pnpm --filter next-vercel-supabase-app check",
    "test:all": "pnpm -r test",
    "typecheck:all": "pnpm -r typecheck",
    "build:all": "pnpm -r build",
    "test:e2e:all": "pnpm -r test:e2e"
  }
}
